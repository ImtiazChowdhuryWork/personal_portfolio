# ============================================================
# FILE: .env.example
# WHAT IT IS:     Example environment configuration template
# WHY IT EXISTS:  Documents all required env variables so any
#                 developer can set up the project without
#                 hunting for what is needed
# WHERE USED:     Copy this to .env and fill in real values
# IF REMOVED:     New developers won't know what config is needed
# LAST UPDATED:   2026-05-07 — initial creation
# ============================================================

# ─── Server Configuration ────────────────────────────────────
# The port the Go HTTP server listens on
# Change this if 8080 is already in use on your machine
SERVER_PORT=8080

# The environment mode — controls logging verbosity and error detail
# Values: development | production
APP_ENV=development

# ─── Database Configuration ──────────────────────────────────
# PostgreSQL connection string
# Format: host=HOST user=USER password=PASS dbname=DB port=PORT sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=imtiaz_portfolio
DB_SSLMODE=disable

# ─── JWT Authentication ──────────────────────────────────────
# Secret key used to sign JWT tokens — KEEP THIS SECRET
# Generate a strong random string for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# How long access tokens are valid before expiring
# Format: 24h, 1h, 30m etc.
JWT_EXPIRY=24h

# How long refresh tokens are valid
JWT_REFRESH_EXPIRY=168h

# ─── File Upload Configuration ───────────────────────────────
# Directory where uploaded files (images, CV) are stored
UPLOAD_DIR=./uploads

# Maximum file size allowed for uploads in megabytes
MAX_UPLOAD_SIZE_MB=10

# ─── CORS Configuration ──────────────────────────────────────
# Which frontend URLs are allowed to call the API
# Separate multiple URLs with comma
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ─── Admin Seed Credentials ──────────────────────────────────
# Default admin account created on first run
# CHANGE THESE immediately after first login in production
ADMIN_EMAIL=admin@imtiaz.dev
ADMIN_PASSWORD=Admin@1234
